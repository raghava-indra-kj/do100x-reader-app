{
  "name": "@reader/md-view",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./md-view.css": "./dist/md-view.css",
    "./md-view-hljs.css": "./dist/md-view-hljs.css",
    "./math.css": "./dist/math.css"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@d2lang/d2": "0.1.33",
    "lucide-react": "^1.18.0",
    "mermaid": "^11.15.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0",
    "@reader/md-ast": "^2.0.0",
    "katex": "0.18.2",
    "@types/mdast": "^4.0.4",
    "mdast-util-math": "^3.0.0",
    "@types/hast": "^3.0.4",
    "unified": "^11.0.5",
    "dompurify": "^3.4.17",
    "micromark-util-decode-string": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "esbuild": "0.28.2",
    "vitest": "^4.1.9",
    "jsdom": "^26.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "description": "Customizable React Markdown rendering with D2, Mermaid, math and syntax highlighting.",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs && node ../../scripts/markdown-declarations.mjs dist",
    "prepack": "npm run build",
    "test": "vitest run",
    "prebuild": "node ../../scripts/clean-markdown-dist.mjs"
  }
}
