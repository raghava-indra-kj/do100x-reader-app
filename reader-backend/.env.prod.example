# Copy to .env.prod once and fill in your production settings.
# The real file and deployment ZIP contain secrets. Never commit or publish them.
NODE_ENV=production
PORT=3000
DATABASE_URL="mysql://DB_USERNAME:URL_ENCODED_PASSWORD@DB_HOST:3306/DB_NAME"
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
APP_ORIGINS=https://do100x.com
# Generate once; keep this value unchanged across deployments and restarts.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
