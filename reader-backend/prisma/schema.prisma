generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Application-independent account identity. Reader and future apps own their
// app-specific preferences and data through separate profile/domain models.
model user_account {
  id             String             @id @default(uuid()) @db.VarChar(36)
  googleSubject  String             @unique @db.VarChar(255)
  email          String             @unique @db.VarChar(320)
  displayName    String             @db.VarChar(255)
  avatarUrl      String?            @db.VarChar(2048)
  createdAt      DateTime           @default(now()) @db.DateTime(6)
  updatedAt      DateTime           @updatedAt @db.DateTime(6)
  sessions       auth_session[]
  readerProfile  reader_profile?
}

// Reader-specific state. Keeping this distinct lets another app (for example,
// Tasks) share an account without taking on Reader navigation preferences.
model reader_profile {
  userId     String       @id @db.VarChar(36)
  homepageId String?      @db.VarChar(36)
  createdAt  DateTime     @db.DateTime(6)
  updatedAt  DateTime     @db.DateTime(6)
  user       user_account @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpAccessToken reader_mcp_access_token?
}

model auth_session {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(6)
  createdAt DateTime @db.DateTime(6)
  user      user_account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model reader_mcp_access_token {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @unique @db.VarChar(36)
  tokenHash String   @unique @db.Char(64)
  createdAt DateTime @db.DateTime(6)
  readerProfile reader_profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model page {
  id                      String    @id @default(uuid()) @db.VarChar(36)
  userId                  String    @db.VarChar(36)
  parentId                String?   @db.VarChar(36)
  title                   String    @db.VarChar(1000)
  content                 String?   @db.LongText
  category                String?   @db.VarChar(255)
  sortOrder               Int
  childrenCount           Int
  isPublic                Boolean   @default(false)
  createdAt               DateTime  @db.DateTime(6)
  updatedAt               DateTime  @db.DateTime(6)
  deletedAt               DateTime? @db.DateTime(6)
  meaningSystemPrompt     String?   @db.Text
  explanationSystemPrompt String?   @db.Text
  doubtSystemPrompt       String?   @db.Text
}

model page_property {
  id        String   @id @default(uuid()) @db.VarChar(36)
  pageId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  key       String   @db.VarChar(255)
  value     String   @db.LongText
  createdAt DateTime @db.DateTime(6)
  updatedAt DateTime @db.DateTime(6)

  @@unique([pageId, key])
  @@index([userId])
  @@index([pageId])
}

model comment {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @db.VarChar(36)
  pageId        String   @db.VarChar(36)
  pageTitle     String   @db.VarChar(1000)
  sectionTitle  String?  @db.VarChar(1000)
  selectedText  String   @db.Text
  body          String   @db.Text
  linkedPageId  String?  @db.VarChar(36)
  isExplanation Boolean  @default(false)
  createdAt     DateTime @db.DateTime(6)
  updatedAt     DateTime @db.DateTime(6)
}

model vocabulary {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  pageId    String   @db.VarChar(36)
  term      String   @db.VarChar(255)
  createdAt DateTime @db.DateTime(6)
}

model model_config {
  id                      String  @id @default(uuid()) @db.VarChar(36)
  userId                  String  @unique @db.VarChar(36)
  baseUrl                 String  @db.VarChar(500)
  apiKey                  String  @db.VarChar(500)
  explanationModelId      String? @db.VarChar(255)
  meaningModelId          String? @db.VarChar(255)
  doubtModelId            String? @db.VarChar(255)
  meaningSystemPrompt     String? @db.Text
  explanationSystemPrompt String? @db.Text
  doubtSystemPrompt       String? @db.Text
}

model user_model {
  id      String  @id @default(uuid()) @db.VarChar(36)
  userId  String  @db.VarChar(36)
  name    String  @db.VarChar(255)
  modelId String  @db.VarChar(255)
  baseUrl String? @db.VarChar(500)
  apiKey  String? @db.VarChar(500)
}

// ----------------------------------------------------
// TASK MANAGEMENT & TIME TRACKING MODELS
// ----------------------------------------------------

model task_list {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  name      String    @db.VarChar(255)
  color     String?   @db.VarChar(50)
  icon      String?   @db.VarChar(50)
  sortOrder Int       @default(0)
  createdAt DateTime  @db.DateTime(6)
  updatedAt DateTime  @db.DateTime(6)
  deletedAt DateTime? @db.DateTime(6)

  @@index([userId])
}

model task {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @db.VarChar(36)
  listId           String?   @db.VarChar(36)
  parentId         String?   @db.VarChar(36)
  title            String    @db.VarChar(1000)
  description      String?   @db.LongText
  status           String    @default("todo") @db.VarChar(50) // "todo", "in_progress", "done", "cancelled"
  priority         Int       @default(4) // 1=P1 Urgent/Important, 2=P2 High, 3=P3 Medium, 4=P4 Low/None
  dueDate          DateTime? @db.DateTime(6)
  dueTime          String?   @db.VarChar(10)
  sortOrder        Int       @default(0)
  totalTimeSeconds Int       @default(0)
  completedAt      DateTime? @db.DateTime(6)
  createdAt        DateTime  @db.DateTime(6)
  updatedAt        DateTime  @db.DateTime(6)
  deletedAt        DateTime? @db.DateTime(6)

  @@index([userId])
  @@index([listId])
  @@index([parentId])
  @@index([status])
  @@index([dueDate])
}

model time_session {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  taskId          String   @db.VarChar(36)
  startTime       DateTime @db.DateTime(6)
  endTime         DateTime? @db.DateTime(6)
  durationSeconds Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @db.DateTime(6)
  updatedAt       DateTime @db.DateTime(6)

  @@index([userId])
  @@index([taskId])
  @@index([startTime])
}

model active_timer {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  userId             String    @unique @db.VarChar(36)
  taskId             String    @db.VarChar(36)
  startTime          DateTime  @db.DateTime(6)
  accumulatedSeconds Int       @default(0)
  isPaused           Boolean   @default(false)
  pausedAt           DateTime? @db.DateTime(6)
  notes              String?   @db.Text
  createdAt          DateTime  @db.DateTime(6)
  updatedAt          DateTime  @db.DateTime(6)

  @@index([taskId])
}
