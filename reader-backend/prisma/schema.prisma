generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model appuser {
  id          String   @id @default(uuid()) @db.VarChar(36)
  displayName String?  @db.VarChar(255)
  email       String   @db.VarChar(320)
  avatarUrl   String?  @db.Text
  createdAt   DateTime @default(now()) @db.DateTime(6)
  updatedAt   DateTime @updatedAt @db.DateTime(6)

  quizAttempts quiz_attempt[]
  identities auth_identity[]
  readerPreferences reader_preferences?
}

enum auth_provider {
  GOOGLE
}

model auth_identity {
  id              String        @id @default(uuid()) @db.VarChar(36)
  userId          String        @db.VarChar(36)
  provider        auth_provider
  providerSubject String        @db.VarChar(255)
  createdAt       DateTime      @default(now()) @db.DateTime(6)
  updatedAt       DateTime      @updatedAt @db.DateTime(6)
  user            appuser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model auth_login_challenge {
  idHash    String   @id @db.Char(64)
  nonceHash String   @db.Char(64)
  expiresAt DateTime @db.DateTime(6)

  @@index([expiresAt])
}

model reader_preferences {
  userId     String   @id @db.VarChar(36)
  homePageId String?  @db.VarChar(36)
  updatedAt  DateTime @updatedAt @db.DateTime(6)
  user       appuser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  homePage   page?    @relation(fields: [homePageId], references: [id], onDelete: SetNull)
}

model user_preferences {
  userId              String   @id @db.VarChar(36)
  motivationsEnabled Boolean  @default(false)
  updatedAt           DateTime @updatedAt @db.DateTime(6)
}

model page {
  id                      String    @id @default(uuid()) @db.VarChar(36)
  userId                  String    @db.VarChar(36)
  parentId                String?   @db.VarChar(36)
  title                   String    @db.VarChar(1000)
  content                 String?   @db.LongText
  contentVersion          Int       @default(0)
  category                String?   @db.VarChar(255)
  sortOrder               Int
  childrenCount           Int
  isPublic                Boolean   @default(false)
  createdAt               DateTime  @db.DateTime(6)
  updatedAt               DateTime  @db.DateTime(6)
  deletedAt               DateTime? @db.DateTime(6)
  meaningSystemPrompt     String?   @db.Text
  explanationSystemPrompt String?   @db.Text
  doubtSystemPrompt       String?   @db.Text

  quizzes quiz[]
  homePreferences reader_preferences[]
}

enum quiz_question_kind {
  OBJECTIVE
  SUBJECTIVE
}

enum quiz_selection_mode {
  SINGLE
  MULTIPLE
}

enum quiz_response_length {
  SHORT
  LONG
}

enum quiz_attempt_status {
  IN_PROGRESS
  SUBMITTED
}

enum quiz_evaluation_source {
  OBJECTIVE
  AI
}

enum quiz_evaluation_verdict {
  CORRECT
  PARTIAL
  INCORRECT
  UNANSWERED
  NEEDS_REVIEW
}

model quiz {
  id                String    @id @default(uuid()) @db.VarChar(36)
  pageId            String    @db.VarChar(36)
  currentRevisionNo Int       @default(1)
  sortOrder         Int       @default(0)
  archivedAt        DateTime? @db.DateTime(6)
  createdAt         DateTime  @default(now()) @db.DateTime(6)
  updatedAt         DateTime  @updatedAt @db.DateTime(6)

  page      page            @relation(fields: [pageId], references: [id], onDelete: Restrict)
  revisions quiz_revision[]

  @@index([pageId, archivedAt, sortOrder])
}

model quiz_revision {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  quizId               String   @db.VarChar(36)
  revisionNo           Int
  title                String   @db.VarChar(255)
  instructionsMarkdown String?  @db.LongText
  createdAt            DateTime @default(now()) @db.DateTime(6)

  quiz      quiz            @relation(fields: [quizId], references: [id], onDelete: Restrict)
  questions quiz_question[]
  attempts  quiz_attempt[]

  @@unique([quizId, revisionNo])
}

model quiz_question {
  id                      String                @id @default(uuid()) @db.VarChar(36)
  revisionId              String                @db.VarChar(36)
  position                Int
  kind                    quiz_question_kind
  selectionMode           quiz_selection_mode?
  responseLength          quiz_response_length?
  promptMarkdown          String                @db.LongText
  referenceAnswerMarkdown String?               @db.LongText
  explanationMarkdown     String                @db.LongText

  revision quiz_revision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  options  quiz_option[]
  answers  quiz_attempt_answer[]

  @@unique([revisionId, position])
}

model quiz_option {
  id           String  @id @default(uuid()) @db.VarChar(36)
  questionId   String  @db.VarChar(36)
  position     Int
  bodyMarkdown String  @db.LongText
  isCorrect    Boolean

  question   quiz_question          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selections quiz_answer_selection[]

  @@unique([questionId, position])
}

model quiz_attempt {
  id              String              @id @default(uuid()) @db.VarChar(36)
  revisionId      String              @db.VarChar(36)
  userId          String              @db.VarChar(36)
  status          quiz_attempt_status @default(IN_PROGRESS)
  startRequestKey String              @db.VarChar(36)
  startedAt       DateTime            @default(now()) @db.DateTime(6)
  submittedAt     DateTime?           @db.DateTime(6)

  revision quiz_revision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user     appuser               @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers  quiz_attempt_answer[]

  @@unique([userId, startRequestKey])
  @@index([userId, startedAt])
  @@index([revisionId])
}

model quiz_attempt_answer {
  id               String   @id @default(uuid()) @db.VarChar(36)
  attemptId        String   @db.VarChar(36)
  questionId       String   @db.VarChar(36)
  responseMarkdown String?  @db.LongText
  updatedAt        DateTime @updatedAt @db.DateTime(6)

  attempt     quiz_attempt             @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question    quiz_question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selections  quiz_answer_selection[]
  evaluations quiz_answer_evaluation[]

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model quiz_answer_selection {
  answerId String @db.VarChar(36)
  optionId String @db.VarChar(36)

  answer quiz_attempt_answer @relation(fields: [answerId], references: [id], onDelete: Restrict)
  option quiz_option         @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@index([optionId])
}

model quiz_answer_evaluation {
  id               String                  @id @default(uuid()) @db.VarChar(36)
  answerId         String                  @db.VarChar(36)
  requestKey       String                  @db.VarChar(36)
  source           quiz_evaluation_source
  verdict          quiz_evaluation_verdict
  scorePercent     Int?
  feedbackMarkdown String                  @db.LongText
  modelId          String?                 @db.VarChar(255)
  promptVersion    String?                 @db.VarChar(50)
  createdAt        DateTime                @default(now()) @db.DateTime(6)

  answer quiz_attempt_answer @relation(fields: [answerId], references: [id], onDelete: Restrict)

  @@unique([answerId, requestKey])
  @@index([answerId, createdAt])
}

model comment {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @db.VarChar(36)
  pageId        String   @db.VarChar(36)
  pageTitle     String   @db.VarChar(1000)
  sectionTitle  String?  @db.VarChar(1000)
  selectedText  String   @db.Text
  body          String   @db.Text
  linkedPageId  String?  @db.VarChar(36)
  isExplanation Boolean  @default(false)
  createdAt     DateTime @db.DateTime(6)
  updatedAt     DateTime @db.DateTime(6)
}

model vocabulary {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  pageId    String   @db.VarChar(36)
  term      String   @db.VarChar(255)
  createdAt DateTime @db.DateTime(6)
}

model model_config {
  id                      String  @id @default(uuid()) @db.VarChar(36)
  userId                  String  @unique @db.VarChar(36)
  baseUrl                 String  @db.VarChar(500)
  apiKey                  String  @db.VarChar(500)
  explanationModelId      String? @db.VarChar(255)
  meaningModelId          String? @db.VarChar(255)
  doubtModelId            String? @db.VarChar(255)
  meaningSystemPrompt     String? @db.Text
  explanationSystemPrompt String? @db.Text
  doubtSystemPrompt       String? @db.Text
}

model user_model {
  id      String  @id @default(uuid()) @db.VarChar(36)
  userId  String  @db.VarChar(36)
  name    String  @db.VarChar(255)
  modelId String  @db.VarChar(255)
  baseUrl String? @db.VarChar(500)
  apiKey  String? @db.VarChar(500)
}

// ----------------------------------------------------
// TASK MANAGEMENT & TIME TRACKING MODELS
// ----------------------------------------------------

model task_list {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  name      String    @db.VarChar(255)
  color     String?   @db.VarChar(50)
  icon      String?   @db.VarChar(50)
  sortOrder Int       @default(0)
  createdAt DateTime  @db.DateTime(6)
  updatedAt DateTime  @db.DateTime(6)
  deletedAt DateTime? @db.DateTime(6)

  @@index([userId])
}

model task {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @db.VarChar(36)
  listId           String?   @db.VarChar(36)
  parentId         String?   @db.VarChar(36)
  title            String    @db.VarChar(1000)
  description      String?   @db.LongText
  status           String    @default("todo") @db.VarChar(50) // "todo", "in_progress", "done", "cancelled"
  priority         Int       @default(4) // 1=P1 Urgent/Important, 2=P2 High, 3=P3 Medium, 4=P4 Low/None
  dueDate          DateTime? @db.DateTime(6)
  dueTime          String?   @db.VarChar(10)
  sortOrder        Int       @default(0)
  totalTimeSeconds Int       @default(0)
  completedAt      DateTime? @db.DateTime(6)
  createdAt        DateTime  @db.DateTime(6)
  updatedAt        DateTime  @db.DateTime(6)
  deletedAt        DateTime? @db.DateTime(6)

  @@index([userId])
  @@index([listId])
  @@index([parentId])
  @@index([status])
  @@index([dueDate])
}

model time_session {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @db.VarChar(36)
  taskId          String   @db.VarChar(36)
  startTime       DateTime @db.DateTime(6)
  endTime         DateTime? @db.DateTime(6)
  durationSeconds Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @db.DateTime(6)
  updatedAt       DateTime @db.DateTime(6)

  @@index([userId])
  @@index([taskId])
  @@index([startTime])
}

model active_timer {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  userId             String    @unique @db.VarChar(36)
  taskId             String    @db.VarChar(36)
  startTime          DateTime  @db.DateTime(6)
  accumulatedSeconds Int       @default(0)
  isPaused           Boolean   @default(false)
  pausedAt           DateTime? @db.DateTime(6)
  notes              String?   @db.Text
  createdAt          DateTime  @db.DateTime(6)
  updatedAt          DateTime  @db.DateTime(6)

  @@index([taskId])
}
